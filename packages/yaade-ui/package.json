      "types": "./src/terminal-registry-entry.ts",
      "default": "./src/terminal-registry-entry.ts"
    },
    "./terminal-file-drop": {
      "types": "./src/terminal-file-drop-entry.ts",
      "default": "./src/terminal-file-drop-entry.ts"
    },
    "./git": {
      "types": "./src/git-entry.ts",
      "default": "./src/git-entry.ts"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ghostty-wasm": "pnpm --filter @yaade/ghostty-react build:ghostty-wasm",
