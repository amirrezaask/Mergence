{
  "name": "@yaade/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives.ts",
      "default": "./src/primitives.ts"
    },
    "./session": {
      "types": "./src/session-entry.ts",
      "default": "./src/session-entry.ts"
    },
    "./gallery": {
      "types": "./src/gallery-entry.ts",
      "default": "./src/gallery-entry.ts"
    },
    "./project": {
      "types": "./src/project-entry.ts",
      "default": "./src/project-entry.ts"
    },
    "./appearance": {
      "types": "./src/appearance-entry.ts",
      "default": "./src/appearance-entry.ts"
    },
    "./notifications": {
      "types": "./src/notifications/index.ts",
      "default": "./src/notifications/index.ts"
    },
    "./settings": {
      "types": "./src/settings-entry.ts",
