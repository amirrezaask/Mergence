{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAADE",
  "version": "0.1.0",
  "identifier": "dev.yaade.desktop",
  "build": {
    "beforeDevCommand": "cd ../.. && vp run dev:web",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "cd ../.. && vp run build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YAADE",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
