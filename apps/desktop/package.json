{
  "name": "@yaade/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron-forge start",
    "build": "node ../../scripts/build-desktop.mjs",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/prepare-packaging.mjs && node scripts/run-forge.mjs package",
    "make": "node scripts/prepare-packaging.mjs && node scripts/run-forge.mjs make",
    "make:dmg": "vp run make:dmg:prepared",
    "make:dmg:prepared": "node scripts/prepare-packaging.mjs && node scripts/run-forge.mjs make --targets dmg"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "^22.15.29",
    "electron": "43.4.0",
    "typescript": "^7.0.2"
  }
}
