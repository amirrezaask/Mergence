{
  "name": "yaade",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs --server-only",
    "dev": "pnpm dev:web",
    "dev:web": "node apps/yaade/scripts/dev-web.mjs",
    "dev:host-server": "pnpm --filter @yaade/host-server start",
    "test:e2e": "playwright test --project=web-e2e",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --config oxlint.config.mjs --disable-nested-config .",
    "test": "pnpm --filter yaade test && pnpm --filter @yaade/rpc test && pnpm --filter @yaade/shared test && pnpm --filter @yaade/panels test && pnpm --filter @yaade/agent-telemetry test && pnpm --filter @yaade/ui test && pnpm --filter @yaade/workspace test && pnpm --filter @yaade/node-host test && pnpm --filter @yaade/host-client test && pnpm --filter @yaade/app test && pnpm --filter @yaade/host-server test",
    "test:bench": "playwright test --project=bench",
    "test:neovim-compat": "pnpm --filter @yaade/host-server test:neovim-compat",
    "extract:vscode-keybindings": "node scripts/extract-vscode-mac-keybindings.mjs && node scripts/generate-default-keybindings.mjs",
    "validate:keybindings": "node scripts/validate-yaade-keybindings.mjs",
    "postinstall": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs",
    "rebuild:native": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "effect": "3.22.1",
    "oxlint": "1.78.0",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.0"
}
