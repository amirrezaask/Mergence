{
  "name": "yaade",
  "private": true,
  "scripts": {
    "build": "pnpm build:server && pnpm build:web && pnpm build:desktop -- --skip-web",
    "build:server": "pnpm --filter @yaade/server build",
    "build:web": "pnpm --filter @yaade/web build",
    "build:desktop": "pnpm --filter @yaade/desktop build",
    "dev:server": "pnpm --filter @yaade/server dev",
    "dev:web": "pnpm --filter @yaade/web dev",
    "dev:web:lan": "pnpm --filter @yaade/web dev -- --host 0.0.0.0",
    "dev:desktop": "pnpm --filter @yaade/desktop dev",
    "test:server": "pnpm --filter @yaade/server test",
    "test:web": "pnpm --filter @yaade/web test && pnpm --filter @yaade/app test",
    "test:desktop": "pnpm --filter @yaade/desktop test",
    "test:web:e2e": "playwright test --project=web-e2e",
    "package:desktop": "pnpm --filter @yaade/desktop package",
    "make:desktop": "pnpm --filter @yaade/desktop make",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --config oxlint.config.mjs --disable-nested-config .",
    "test": "turbo run test --concurrency=3",
    "test:bench": "playwright test --project=bench",
    "extract:vscode-keybindings": "node scripts/extract-vscode-mac-keybindings.mjs && node scripts/generate-default-keybindings.mjs",
    "validate:keybindings": "node scripts/validate-yaade-keybindings.mjs",
    "postinstall": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs",
    "rebuild:native": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "effect": "3.22.1",
    "esbuild": "0.28.1",
    "oxlint": "1.79.0",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.0"
}
