{
  "name": "yaade",
  "private": true,
  "scripts": {
    "build": "vp run build:server && vp run build:web && vp run build:desktop -- --skip-web",
    "build:server": "vp run --filter @yaade/server build",
    "build:web": "vp run --filter @yaade/web build",
    "build:desktop": "vp run --filter @yaade/desktop build",
    "dev": "vp run --parallel --filter @yaade/server --filter @yaade/web dev",
    "dev:server": "vp run @yaade/server#dev",
    "dev:web": "vp run --filter @yaade/web dev",
    "dev:web:lan": "vp run --filter @yaade/web dev -- --host 0.0.0.0",
    "dev:desktop": "vp run --filter @yaade/desktop dev",
    "test:server": "vp test packages/yaade-host-server",
    "test:web": "vp test apps/web packages/yaade-app",
    "test:desktop": "vp test apps/desktop",
    "test:web:e2e": "vp exec playwright test --project=web-e2e",
    "package:desktop": "vp run --filter @yaade/desktop package",
    "make:desktop": "vp run --filter @yaade/desktop make",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "test": "vp test",
    "test:bench": "vp exec playwright test --project=bench",
    "rebuild:native": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "effect": "3.22.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "workspaces": {
    "packages": [
      "apps/desktop",
      "apps/web",
      "apps/server",
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
      "vite-plus": "0.2.9"
    }
  }
}
