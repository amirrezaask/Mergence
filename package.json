{
  "name": "yaade",
  "private": true,
  "scripts": {
    "build": "vp run build:release",
    "build:server": "vp run --filter @yaade/server build",
    "build:web": "vp run --filter @yaade/web build",
    "build:desktop": "vp run --filter @yaade/desktop build",
    "build:release": "node scripts/build-release.mjs",
    "dev": "vp run --parallel --filter @yaade/server --filter @yaade/web dev",
    "dev:server": "vp run @yaade/server#dev",
    "dev:web": "vp run --filter @yaade/web dev",
    "dev:desktop": "vp run --filter @yaade/desktop dev",
    "dev:web:lan": "vp run --filter @yaade/web dev -- --host 0.0.0.0",
    "test:server": "vp test packages/yaade-host-server",
    "test:server:rust": "cargo test --manifest-path apps/server/Cargo.toml",
    "test:web": "vp test apps/web packages/yaade-app",
    "test:desktop": "vp run --filter @yaade/desktop test",
    "test:terminal:unit": "vp test packages/yaade-node-host/src/terminal-control.test.ts packages/yaade-node-host/src/pty-write-queue.test.ts packages/yaade-node-host/src/terminal.test.ts packages/yaade-host-server/src/route-policy.test.ts packages/yaade-host-server/src/ws/client-mailbox.test.ts packages/yaade-host-server/src/ws/client-socket-writer.test.ts packages/yaade-host-server/src/terminal-authority.test.ts packages/yaade-rpc/src/terminal-stream-v3.test.ts packages/yaade-host-client/src/terminal-v3-store.test.ts",
    "test:terminal:protocol": "vp test packages/yaade-rpc/src/terminal-stream-v3-codec.test.ts",
    "test:terminal:integration": "vp test packages/yaade-node-host/src/terminal-semantic-runtime.test.ts packages/yaade-host-server/src/security-scopes.integration.test.ts",
    "test:web:e2e": "vp exec playwright test --project=web-e2e",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "lint:server:rust": "cargo fmt --manifest-path apps/server/Cargo.toml -- --check && cargo clippy --manifest-path apps/server/Cargo.toml --all-targets -- -D warnings",
    "test": "vp test",
    "test:bench": "vp exec playwright test --project=bench",
    "rebuild:native": "node packages/yaade-node-host/scripts/fix-node-pty-perms.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "effect": "3.22.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "workspaces": {
    "packages": [
      "apps/web",
      "apps/server",
      "apps/desktop",
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
      "vite-plus": "0.2.9"
    }
  }
}
